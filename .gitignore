# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ─────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/phpmailer/vendor/

# ── Testing ───────────────────────────────────────────────
/coverage

# ── Next.js ───────────────────────────────────────────────
/.next/
/out/
/build
tsconfig.tsbuildinfo
next-env.d.ts

# ── Environment / Secrets — NEVER COMMIT THESE ───────────
.env
.env.local
.env.production
.env*.local
Admin/.env
Admin/.env.production
Admin/.env.local

# ── Debug / Logs ──────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── OS / Editor ───────────────────────────────────────────
.DS_Store
*.pem
.vscode/
.idea/

# ── Uploaded User Images (binary, large) ─────────────────
/img/menu/*
/img/banners/*
/img/slides/*
/img/notices/*
/img/review/*
# Keep the directories themselves
!/img/menu/.gitkeep
!/img/banners/.gitkeep
!/img/slides/.gitkeep
!/img/notices/.gitkeep
!/img/review/.gitkeep

# ── Misc ──────────────────────────────────────────────────
.vercel
*.bak
*.old
*.tmp
CREATE_PRODUCTION_ZIP.ps1
start.bat
stop.bat
